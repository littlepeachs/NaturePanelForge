# Copy this file to .env or source it in your shell before running the demos.

# Project roots. This template works when sourced in-place from configs/ or
# after being copied to .env at the repository root.
_NPF_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ "$(basename "${_NPF_ENV_DIR}")" == "configs" ]]; then
  export NPF_ROOT="${NPF_ROOT:-$(cd "${_NPF_ENV_DIR}/.." && pwd)}"
else
  export NPF_ROOT="${NPF_ROOT:-${_NPF_ENV_DIR}}"
fi
unset _NPF_ENV_DIR
export RUN_ROOT="$NPF_ROOT/PipelineRuns"
export STATE_ROOT="$NPF_ROOT/PipelineState"
export FINAL_ROOT="$NPF_ROOT/Final"
export GALLERY_ROOT="$NPF_ROOT/gallery"

# Demo topic.
export DOMAIN="biology"
export SUBJECT="biology"
export TOPIC="AI_biology"
export QUERY_DOMAIN="biology"
export YEARS="2025,2026"
export TARGET_PAPERS=2
export BATCH_SIZE=2
export MAX_BATCHES=1
export FIGURES_PER_PAPER=2

# Full figure download.
export FULL_FIGURE_WORKERS=8
export FULL_FIGURE_BATCH_SIZE=4
export FULL_FIGURE_BATCH_SLEEP=0.5

# Codex CLI.
export CODEX_MODEL="gpt-5.4"
export CODEX_REASONING_EFFORT="medium"
export CODEX_JOBS=4
export MAX_CODEX_PROCESSES=8
export CODEX_TIMEOUT=2400
export CODEX_REVIEW_ROUNDS=4
export CODEX_RETRIES=8
export CODEX_RETRY_SLEEP=20
export CODEX_POLL_SECONDS=10
export CODEX_PROCESS_USER="${USER:-unknown}"

# Local Qwen vision model for panel classification/scoring.
export CUDA_VISIBLE_DEVICES=0
export QWEN_MODEL_PATH="/path/to/Qwen3.6-27B"
export SCORE_BATCH_SIZE=4

# Selection thresholds for statistical panels.
export MIN_DATA_PURITY_SCORE=10
export MIN_CODE_REPRODUCIBILITY_SCORE=9
export MIN_AESTHETIC_SCORE=8
