# SciFigure2Code zero-shot benchmark environment.
#
# Copy values into your shell or a local .env file. Do not commit real tokens.

# Hugging Face token is required for gated models such as Gemma/Phi/Pixtral/Molmo.
export HF_TOKEN="${HF_TOKEN:-}"

# Model cache root. Downloaded models go under ${VLM_MODEL_ROOT}/ORG/REPO.
export VLM_ROOT="${PWD}/.models"
export VLM_MODEL_ROOT="${VLM_ROOT}/models"

# Optional ChartCoder source checkout. Required only for --model-id chartcoder.
export CHARTCODER_REPO="${PWD}/.deps/ChartCoder"

# Default benchmark manifest. Replace with a local/Hugging Face downloaded full manifest if needed.
export SCIFIGURE_DATASET="${PWD}/SciFigure2Code/benchmark_ready/clean_tiny100.json"

# Run outputs are ignored by git.
export BENCHMARK_RUN_ROOT="${PWD}/BenchmarkRuns"

# Inference settings.
export GPU_IDS=0
export MAX_NEW_TOKENS=2048
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Set to 1 when all weights are already local.
export TRANSFORMERS_OFFLINE=0
export HF_HUB_OFFLINE=0
